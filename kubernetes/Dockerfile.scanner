# Prowler CNAPP Scanner Worker
# Includes Trivy, TruffleHog, and Syft for agentless scanning

FROM python:3.12-slim AS base

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Trivy
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin

# Install TruffleHog
RUN curl -sSfL https://raw.githubusercontent.com/trufflesecurity/trufflehog/main/scripts/install.sh | sh -s -- -b /usr/local/bin

# Install Syft (SBOM generator)
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin

# Python dependencies
WORKDIR /app
COPY api/pyproject.toml api/uv.lock ./
RUN pip install uv && uv sync --frozen --no-dev

# Application code
COPY api/src/ ./src/
COPY prowler/ ./prowler/

ENV PYTHONPATH=/app/src/backend

# Run as non-root
RUN useradd -m scanner
USER scanner

# Celery worker with scanner queue
CMD ["celery", "-A", "config.celery", "worker", "-Q", "scanner", "-c", "2", "--loglevel=info"]
